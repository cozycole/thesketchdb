{{ define "title" }}Resend Verification Email{{ end }}

{{ define "main" }}
  <main class="flex flex-1 items-center justify-center bg-slate-50 px-4 py-12">
    <div class="w-full max-w-sm space-y-4">
      <div
        class="rounded-xl border border-slate-200 bg-white px-8 py-10 shadow-sm"
      >
        <!-- Icon -->
        <div
          class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-orange-50"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-7 w-7 text-orange-600"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
        </div>

        <!-- Header -->
        <div class="mb-8 text-center">
          <h1 class="text-2xl font-bold tracking-tight text-slate-900">
            Resend verification email
          </h1>

          <p class="mt-3 text-sm leading-6 text-slate-500">
            Enter your email address below and we'll send you a new link to
            activate your account.
          </p>
        </div>

        <!-- Form -->
        <form
          action="/resend-verification"
          method="POST"
          novalidate
          class="space-y-4"
        >
          <!-- Email -->
          <div>
            <label
              for="email"
              class="mb-1.5 block text-sm font-medium text-slate-700"
            >
              Email address
            </label>

            <input
              id="email"
              type="email"
              name="email"
              autocomplete="email"
              placeholder="Enter your email"
              value="{{ .Forms.ResendActivation.Email }}"
              required
              class="w-full rounded-lg border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20"
            />

            {{ with .Forms.ResendActivation.FieldErrors.email }}
              <p class="mt-1 text-xs text-red-600">{{ . }}</p>
            {{ end }}
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="w-full rounded-lg bg-orange-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2"
          >
            Resend verification email
          </button>
        </form>
      </div>

      <!-- Login Card -->
      <div
        class="rounded-xl border border-slate-200 bg-white px-6 py-5 text-center shadow-sm"
      >
        <p class="text-sm text-slate-600">
          Already verified your email?
          <a
            href="/login"
            class="ml-1 font-semibold text-orange-600 hover:text-orange-500 hover:underline"
          >
            Back to login
          </a>
        </p>
      </div>
    </div>
  </main>
{{ end }}

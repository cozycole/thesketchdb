{{ define "title" }}Check Your Email{{ end }}

{{ define "main" }}
  <main class="flex flex-1 items-center justify-center bg-slate-50 px-4 py-12">
    <div class="w-full max-w-sm space-y-4">
      <!-- Confirmation Card -->
      <div
        class="rounded-xl border border-slate-200 bg-white px-8 py-10 text-center shadow-sm"
      >
        <!-- Email Icon -->
        <div
          class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-orange-50"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-7 w-7 text-orange-600"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
        </div>

        <!-- Header -->
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">
          Check your email
        </h1>

        <p class="mt-3 text-sm leading-6 text-slate-500">
          If an account exists with that email address, we've sent instructions
          to reset your password.
        </p>

        <!-- Additional Instructions -->
        <p class="mt-6 text-xs leading-5 text-slate-400">
          Didn't receive an email? Check your spam folder or try again.
        </p>

        <!-- Retry Link -->
        <a
          href="/forgot-password"
          class="mt-5 inline-block text-sm font-semibold text-orange-600 hover:text-orange-500 hover:underline"
        >
          Try again
        </a>
      </div>

      <!-- Login Card -->
      <div
        class="rounded-xl border border-slate-200 bg-white px-6 py-5 text-center shadow-sm"
      >
        <p class="text-sm text-slate-600">
          Remember your password?
          <a
            href="/login"
            class="ml-1 font-semibold text-orange-600 hover:text-orange-500 hover:underline"
          >
            Back to login
          </a>
        </p>
      </div>
    </div>
  </main>
{{ end }}

{{ define "title" }}Invalid or Expired Link{{ end }}

{{ define "main" }}
  <main class="flex flex-1 items-center justify-center bg-slate-50 px-4 py-12">
    <div class="w-full max-w-sm space-y-4">
      <div
        class="rounded-xl border border-slate-200 bg-white px-8 py-10 text-center shadow-sm"
      >
        <div
          class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-red-50"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-7 w-7 text-red-500"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9" />
            <path d="M12 8v4" />
            <path d="M12 16h.01" />
          </svg>
        </div>

        <!-- Header -->
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">
          Invalid or expired link
        </h1>

        {{ if eq .TokenScope "password-reset" }}
          <p class="mt-3 text-sm leading-6 text-slate-500">
            This password reset link is invalid or has expired. Please request a
            new link to reset your password.
          </p>
        {{ else if eq .TokenScope "activation" }}
          <p class="mt-3 text-sm leading-6 text-slate-500">
            This account activation link is invalid or has expired. Please
            request a new verification email to activate your account.
          </p>
        {{ else }}
          <p class="mt-3 text-sm leading-6 text-slate-500">
            This link is no longer valid. Please request a new link and try
            again.
          </p>
        {{ end }}


        <!-- Recovery Action -->
        <div class="mt-8">
          {{ if eq .TokenScope "password-reset" }}
            <a
              href="/forgot-password"
              class="block w-full rounded-lg bg-orange-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2"
            >
              Request new reset link
            </a>
          {{ else if eq .TokenScope "activation" }}
            <a
              href="/resend-verification"
              class="block w-full rounded-lg bg-orange-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2"
            >
              Resend verification email
            </a>
          {{ else }}
            <a
              href="/"
              class="block w-full rounded-lg bg-orange-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2"
            >
              Return home
            </a>
          {{ end }}
        </div>
      </div>

      <!-- Login Card -->
      <div
        class="rounded-xl border border-slate-200 bg-white px-6 py-5 text-center shadow-sm"
      >
        <p class="text-sm text-slate-600">
          Already have an account?
          <a
            href="/login"
            class="ml-1 font-semibold text-orange-600 hover:text-orange-500 hover:underline"
          >
            Back to login
          </a>
        </p>
      </div>
    </div>
  </main>
{{ end }}

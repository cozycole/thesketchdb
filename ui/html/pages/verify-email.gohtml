{{ define "title" }}Verify Email{{ end }}

{{ define "main" }}
  <main class="flex flex-1 items-center justify-center bg-slate-50 px-4 py-12">
    <div class="w-full max-w-sm">
      <!-- Verification Card -->
      <div
        class="rounded-xl border border-slate-200 bg-white px-8 py-10 text-center shadow-sm"
      >
        {{ if .Token }}

          <!-- Activation Icon -->
          <div
            class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-orange-50"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-7 w-7 text-orange-600"
              aria-hidden="true"
            >
              <path d="M9 12l2 2 4-4" />
              <circle cx="12" cy="12" r="9" />
            </svg>
          </div>

          <!-- Header -->
          <h1 class="text-2xl font-bold tracking-tight text-slate-900">
            Activate your account
          </h1>

          <p class="mt-3 text-sm leading-6 text-slate-500">
            You're almost there! Confirm your email address to activate your
            account and get started.
          </p>

          <!-- Activation Form -->
          <form method="POST" action="/activate-user" class="mt-8">
            <input type="hidden" name="token" value="{{ .Token }}" />

            <button
              type="submit"
              class="w-full rounded-lg bg-orange-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2"
            >
              Activate account
            </button>
          </form>
        {{ else }}
          <!-- Email Icon -->
          <div
            class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-orange-50"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-7 w-7 text-orange-600"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
          </div>

          <!-- Header -->
          <h1 class="text-2xl font-bold tracking-tight text-slate-900">
            Check your email
          </h1>

          <p class="mt-3 text-sm leading-6 text-slate-500">
            We've sent you an email with instructions to verify your address and
            activate your account.
          </p>

          <!-- Additional Instructions -->
          <p class="mt-6 text-xs leading-5 text-slate-400">
            Didn't receive the email? Check your spam folder or request a new
            verification link.
          </p>

          <!-- Resend Link -->
          <a
            href="/resend-verification"
            class="mt-5 inline-block text-sm font-semibold text-orange-600 hover:text-orange-500 hover:underline"
          >
            Resend verification email
          </a>
        {{ end }}

      </div>

      <!-- Login Card -->
      <div
        class="mt-4 rounded-xl border border-slate-200 bg-white px-6 py-5 text-center shadow-sm"
      >
        <p class="text-sm text-slate-600">
          Already verified?
          <a
            href="/login"
            class="ml-1 font-semibold text-orange-600 hover:text-orange-500 hover:underline"
          >
            Log in
          </a>
        </p>
      </div>
    </div>
  </main>
{{ end }}

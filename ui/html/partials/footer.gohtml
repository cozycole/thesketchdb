{{ define "footer" }}
  <footer class="border-t border-slate-200 bg-white">
    <div class="mx-auto max-w-screen-xl px-4 py-8">
      <div
        class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between"
      >
        <div class="max-w-md">
          <a href="/" class="text-lg font-bold text-slate-950"> TheSketchDb </a>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            A database for sketch comedy shows, sketches, cast members,
            characters, quotes, and ratings.
          </p>
        </div>

        <nav class="grid grid-cols-2 gap-8 text-sm sm:grid-cols-3">
          <div>
            <h2 class="font-semibold text-slate-950">Browse</h2>
            <ul class="mt-3 space-y-2 text-slate-600">
              <li>
                <a
                  href="/catalog/sketches"
                  class="hover:text-slate-950 hover:underline"
                  >Sketches</a
                >
              </li>
              <li>
                <a
                  href="/catalog/people"
                  class="hover:text-slate-950 hover:underline"
                  >People</a
                >
              </li>
              <li>
                <a
                  href="/catalog/characters"
                  class="hover:text-slate-950 hover:underline"
                  >Characters</a
                >
              </li>
              <li>
                <a
                  href="/catalog/series"
                  class="hover:text-slate-950 hover:underline"
                  >Shows / Creators</a
                >
              </li>
            </ul>
          </div>

          <div>
            <h2 class="font-semibold text-slate-950">Account</h2>
            <ul class="mt-3 space-y-2 text-slate-600">
              <li>
                <a href="/login" class="hover:text-slate-950 hover:underline"
                  >Log in</a
                >
              </li>
              <li>
                <a href="/signup" class="hover:text-slate-950 hover:underline"
                  >Sign up</a
                >
              </li>
              <li>
                <a
                  href="/favorites"
                  class="hover:text-slate-950 hover:underline"
                  >Favorites</a
                >
              </li>
            </ul>
          </div>

          <div>
            <h2 class="font-semibold text-slate-950">Site</h2>
            <ul class="mt-3 space-y-2 text-slate-600">
              <li>
                <a href="/about" class="hover:text-slate-950 hover:underline"
                  >About</a
                >
              </li>
              <li>
                <a href="/contact" class="hover:text-slate-950 hover:underline"
                  >Contact</a
                >
              </li>
              <li>
                <a href="/privacy" class="hover:text-slate-950 hover:underline"
                  >Privacy</a
                >
              </li>
              <li>
                <a href="/terms" class="hover:text-slate-950 hover:underline"
                  >Terms</a
                >
              </li>
            </ul>
          </div>
        </nav>
      </div>

      <div
        class="mt-8 flex flex-col gap-2 border-t border-slate-200 pt-4 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between"
      >
        <p>&copy; {{ .CurrentYear }} TheSketchDb. All rights reserved.</p>
        <p>Made for sketch comedy fans.</p>
      </div>
    </div>
  </footer>
{{ end }}

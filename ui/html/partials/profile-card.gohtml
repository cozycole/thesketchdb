{{ define "profile-card" }}
  <div class="flex flex-col w-full min-w-0 items-center">
    <a class="block w-full max-w-28" href="{{ .Url }}">
      <img
        src="{{ .ImageUrl }}"
        class="w-full aspect-square object-cover rounded-full border border-slate-300"
        data-fallback="/static/img/missing-thumbnail.jpg"
      />
    </a>

    <h3
      class="mt-4 font-bold text-slate-950 text-center line-clamp-2 hover:underline"
    >
      <a href="{{ .Url }}">{{ .Title }}</a>
    </h3>

    <h4 class="font-medium text-sm italic text-center">
      {{ .Subtitle }}
    </h4>
  </div>
{{ end }}
